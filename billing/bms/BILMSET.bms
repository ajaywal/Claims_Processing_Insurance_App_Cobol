*----------------------------------------------------------------------
* BILMSET - BillingCoreAJ2026 3270 mapset (BMS)
*   BILMNU menu (BMNU)        BILACM account summary (BACI)
*   BILPYM payment entry (BPAY) BILIVM invoice list (BIVL)
* Symbolic map: python3 tools/bmsgen.py billing/bms/BILMSET.bms
*               billing/cpy  ->  billing/cpy/BILMSET.cpy
* 2026-10-27 AJ  Initial version
*----------------------------------------------------------------------
BILMSET  DFHMSD TYPE=&SYSPARM,MODE=INOUT,LANG=COBOL,STORAGE=AUTO,      X
               CTRL=(FREEKB,FRSET),TIOAPFX=YES,DSATTS=(COLOR,HILIGHT), X
               MAPATTS=(COLOR,HILIGHT)
*--- BILMNU  main menu
BILMNU   DFHMDI SIZE=(24,80),LINE=1,COLUMN=1
         DFHMDF POS=(1,1),LENGTH=6,ATTRB=(ASKIP,NORM),INITIAL='BILMNU'
         DFHMDF POS=(1,12),LENGTH=17,ATTRB=(ASKIP,NORM),               X
               INITIAL='BillingCoreAJ2026'
         DFHMDF POS=(1,32),LENGTH=17,ATTRB=(ASKIP,BRT),                X
               INITIAL='BILLING MAIN MENU'
MNUDATE  DFHMDF POS=(1,70),LENGTH=10,ATTRB=(ASKIP,NORM)
         DFHMDF POS=(2,1),LENGTH=4,ATTRB=(ASKIP,NORM),INITIAL='User'
MNUUSER  DFHMDF POS=(2,6),LENGTH=8,ATTRB=(ASKIP,NORM)
         DFHMDF POS=(5,10),LENGTH=34,ATTRB=(ASKIP,NORM),               X
               INITIAL='1  Account inquiry          (BACI)'
         DFHMDF POS=(6,10),LENGTH=34,ATTRB=(ASKIP,NORM),               X
               INITIAL='2  Payment entry            (BPAY)'
         DFHMDF POS=(7,10),LENGTH=34,ATTRB=(ASKIP,NORM),               X
               INITIAL='3  Invoice list             (BIVL)'
         DFHMDF POS=(10,10),LENGTH=15,ATTRB=(ASKIP,NORM),              X
               INITIAL='Option ........'
MNUOPT   DFHMDF POS=(10,26),LENGTH=1,ATTRB=(UNPROT,BRT,IC,FSET)
         DFHMDF POS=(10,28),LENGTH=1,ATTRB=(ASKIP,DRK)
         DFHMDF POS=(12,10),LENGTH=15,ATTRB=(ASKIP,NORM),              X
               INITIAL='Account number '
MNUACCT  DFHMDF POS=(12,26),LENGTH=10,ATTRB=(UNPROT,BRT,FSET)
         DFHMDF POS=(12,37),LENGTH=1,ATTRB=(ASKIP,DRK)
         DFHMDF POS=(13,10),LENGTH=43,ATTRB=(ASKIP,NORM),              X
               INITIAL='(optional - carried to the selected screen)'
MNUMSG   DFHMDF POS=(23,1),LENGTH=79,ATTRB=(ASKIP,BRT)
MNUPFK   DFHMDF POS=(24,1),LENGTH=79,ATTRB=(ASKIP,NORM),               X
               INITIAL='ENTER=Select  PF3=Exit'
*--- BILACM  account summary
BILACM   DFHMDI SIZE=(24,80),LINE=1,COLUMN=1
         DFHMDF POS=(1,1),LENGTH=6,ATTRB=(ASKIP,NORM),INITIAL='BILACM'
         DFHMDF POS=(1,12),LENGTH=17,ATTRB=(ASKIP,NORM),               X
               INITIAL='BillingCoreAJ2026'
         DFHMDF POS=(1,32),LENGTH=15,ATTRB=(ASKIP,BRT),                X
               INITIAL='ACCOUNT SUMMARY'
ACMDATE  DFHMDF POS=(1,70),LENGTH=10,ATTRB=(ASKIP,NORM)
         DFHMDF POS=(3,1),LENGTH=7,ATTRB=(ASKIP,NORM),INITIAL='Account'
ACMACCT  DFHMDF POS=(3,9),LENGTH=10,ATTRB=(UNPROT,BRT,IC,FSET)
         DFHMDF POS=(3,20),LENGTH=1,ATTRB=(ASKIP,DRK)
ACMNAME  DFHMDF POS=(3,22),LENGTH=58,ATTRB=(ASKIP,BRT)
         DFHMDF POS=(4,1),LENGTH=4,ATTRB=(ASKIP,NORM),INITIAL='Type'
ACMTYPE  DFHMDF POS=(4,9),LENGTH=4,ATTRB=(ASKIP,NORM)
         DFHMDF POS=(4,15),LENGTH=6,ATTRB=(ASKIP,NORM),INITIAL='Status'
ACMSTAT  DFHMDF POS=(4,22),LENGTH=4,ATTRB=(ASKIP,NORM)
         DFHMDF POS=(4,28),LENGTH=10,ATTRB=(ASKIP,NORM),               X
               INITIAL='Collection'
ACMCOLL  DFHMDF POS=(4,39),LENGTH=4,ATTRB=(ASKIP,BRT)
         DFHMDF POS=(4,45),LENGTH=11,ATTRB=(ASKIP,NORM),               X
               INITIAL='Delinq plan'
ACMPLAN  DFHMDF POS=(4,57),LENGTH=8,ATTRB=(ASKIP,NORM)
         DFHMDF POS=(5,1),LENGTH=5,ATTRB=(ASKIP,NORM),INITIAL='Level'
ACMLEVL  DFHMDF POS=(5,9),LENGTH=4,ATTRB=(ASKIP,NORM)
         DFHMDF POS=(5,15),LENGTH=7,ATTRB=(ASKIP,NORM),                X
               INITIAL='Inv day'
ACMIDAY  DFHMDF POS=(5,23),LENGTH=2,ATTRB=(ASKIP,NORM)
         DFHMDF POS=(5,28),LENGTH=7,ATTRB=(ASKIP,NORM),                X
               INITIAL='Autopay'
ACMAUTO  DFHMDF POS=(5,39),LENGTH=1,ATTRB=(ASKIP,NORM)
         DFHMDF POS=(5,45),LENGTH=8,ATTRB=(ASKIP,NORM),                X
               INITIAL='Delivery'
ACMDLVY  DFHMDF POS=(5,57),LENGTH=4,ATTRB=(ASKIP,NORM)
         DFHMDF POS=(5,63),LENGTH=6,ATTRB=(ASKIP,NORM),INITIAL='Opened'
ACMOPEN  DFHMDF POS=(5,70),LENGTH=10,ATTRB=(ASKIP,NORM)
         DFHMDF POS=(7,1),LENGTH=8,ATTRB=(ASKIP,NORM),                 X
               INITIAL='Unbilled'
ACMUNBL  DFHMDF POS=(7,11),LENGTH=15,ATTRB=(ASKIP,NORM)
         DFHMDF POS=(7,30),LENGTH=6,ATTRB=(ASKIP,NORM),INITIAL='Billed'
ACMBILD  DFHMDF POS=(7,40),LENGTH=15,ATTRB=(ASKIP,NORM)
         DFHMDF POS=(8,1),LENGTH=3,ATTRB=(ASKIP,NORM),INITIAL='Due'
ACMDUE   DFHMDF POS=(8,11),LENGTH=15,ATTRB=(ASKIP,BRT)
         DFHMDF POS=(8,30),LENGTH=9,ATTRB=(ASKIP,NORM),                X
               INITIAL='Unapplied'
ACMUNAP  DFHMDF POS=(8,40),LENGTH=15,ATTRB=(ASKIP,NORM)
         DFHMDF POS=(9,1),LENGTH=8,ATTRB=(ASKIP,NORM),                 X
               INITIAL='Net owed'
ACMNET   DFHMDF POS=(9,11),LENGTH=15,ATTRB=(ASKIP,BRT)
         DFHMDF POS=(11,1),LENGTH=7,ATTRB=(ASKIP,NORM),                X
               INITIAL='Contact'
ACMCNAM  DFHMDF POS=(11,11),LENGTH=60,ATTRB=(ASKIP,NORM)
         DFHMDF POS=(12,1),LENGTH=7,ATTRB=(ASKIP,NORM),                X
               INITIAL='Address'
ACMADR1  DFHMDF POS=(12,11),LENGTH=60,ATTRB=(ASKIP,NORM)
ACMADR2  DFHMDF POS=(13,11),LENGTH=60,ATTRB=(ASKIP,NORM)
ACMCITY  DFHMDF POS=(14,11),LENGTH=40,ATTRB=(ASKIP,NORM)
ACMPOST  DFHMDF POS=(14,53),LENGTH=8,ATTRB=(ASKIP,NORM)
         DFHMDF POS=(15,1),LENGTH=5,ATTRB=(ASKIP,NORM),INITIAL='Email'
ACMMAIL  DFHMDF POS=(15,11),LENGTH=60,ATTRB=(ASKIP,NORM)
         DFHMDF POS=(16,1),LENGTH=5,ATTRB=(ASKIP,NORM),INITIAL='Phone'
ACMPHON  DFHMDF POS=(16,11),LENGTH=20,ATTRB=(ASKIP,NORM)
         DFHMDF POS=(17,1),LENGTH=14,ATTRB=(ASKIP,NORM),               X
               INITIAL='Policy periods'
ACMPAGE  DFHMDF POS=(17,60),LENGTH=20,ATTRB=(ASKIP,NORM)
         DFHMDF POS=(18,3),LENGTH=41,ATTRB=(ASKIP,NORM),               X
               INITIAL='Period id  Policy no Prod Status  Expires'
ACMPLN   DFHMDF POS=(19,3),LENGTH=70,ATTRB=(ASKIP,NORM),OCCURS=4
ACMMSG   DFHMDF POS=(23,1),LENGTH=79,ATTRB=(ASKIP,BRT)
ACMPFK   DFHMDF POS=(24,1),LENGTH=79,ATTRB=(ASKIP,NORM),               X
               INITIAL='PF3=Menu PF4=Inv PF5=Pay PF7/8=Page'
*--- BILPYM  payment entry
BILPYM   DFHMDI SIZE=(24,80),LINE=1,COLUMN=1
         DFHMDF POS=(1,1),LENGTH=6,ATTRB=(ASKIP,NORM),INITIAL='BILPYM'
         DFHMDF POS=(1,12),LENGTH=17,ATTRB=(ASKIP,NORM),               X
               INITIAL='BillingCoreAJ2026'
         DFHMDF POS=(1,32),LENGTH=13,ATTRB=(ASKIP,BRT),                X
               INITIAL='PAYMENT ENTRY'
PYMDATE  DFHMDF POS=(1,70),LENGTH=10,ATTRB=(ASKIP,NORM)
         DFHMDF POS=(3,1),LENGTH=14,ATTRB=(ASKIP,NORM),                X
               INITIAL='Account number'
PYMACCT  DFHMDF POS=(3,17),LENGTH=10,ATTRB=(UNPROT,BRT,IC,FSET)
         DFHMDF POS=(3,28),LENGTH=1,ATTRB=(ASKIP,DRK)
         DFHMDF POS=(3,32),LENGTH=13,ATTRB=(ASKIP,NORM),               X
               INITIAL='or Invoice no'
PYMINVN  DFHMDF POS=(3,46),LENGTH=12,ATTRB=(UNPROT,BRT,FSET)
         DFHMDF POS=(3,59),LENGTH=1,ATTRB=(ASKIP,DRK)
         DFHMDF POS=(4,1),LENGTH=12,ATTRB=(ASKIP,NORM),                X
               INITIAL='Amount (GBP)'
PYMAMT   DFHMDF POS=(4,17),LENGTH=13,ATTRB=(UNPROT,BRT,FSET)
         DFHMDF POS=(4,31),LENGTH=1,ATTRB=(ASKIP,DRK)
         DFHMDF POS=(5,1),LENGTH=6,ATTRB=(ASKIP,NORM),INITIAL='Method'
PYMMETH  DFHMDF POS=(5,17),LENGTH=4,ATTRB=(UNPROT,BRT,FSET)
         DFHMDF POS=(5,22),LENGTH=1,ATTRB=(ASKIP,DRK)
         DFHMDF POS=(5,32),LENGTH=23,ATTRB=(ASKIP,NORM),               X
               INITIAL='CASH CHEQ CARD ACH BACS'
         DFHMDF POS=(6,1),LENGTH=9,ATTRB=(ASKIP,NORM),                 X
               INITIAL='Reference'
PYMREF   DFHMDF POS=(6,17),LENGTH=20,ATTRB=(UNPROT,BRT,FSET)
         DFHMDF POS=(6,38),LENGTH=1,ATTRB=(ASKIP,DRK)
         DFHMDF POS=(7,1),LENGTH=13,ATTRB=(ASKIP,NORM),                X
               INITIAL='Received date'
PYMRDAT  DFHMDF POS=(7,17),LENGTH=10,ATTRB=(UNPROT,BRT,FSET)
         DFHMDF POS=(7,28),LENGTH=1,ATTRB=(ASKIP,DRK)
         DFHMDF POS=(7,32),LENGTH=25,ATTRB=(ASKIP,NORM),               X
               INITIAL='yyyy-mm-dd, blank = today'
         DFHMDF POS=(9,1),LENGTH=5,ATTRB=(ASKIP,NORM),INITIAL='Payer'
PYMANAM  DFHMDF POS=(9,17),LENGTH=60,ATTRB=(ASKIP,BRT)
         DFHMDF POS=(10,1),LENGTH=13,ATTRB=(ASKIP,NORM),               X
               INITIAL='Currently due'
PYMADUE  DFHMDF POS=(10,17),LENGTH=15,ATTRB=(ASKIP,NORM)
         DFHMDF POS=(10,40),LENGTH=11,ATTRB=(ASKIP,NORM),              X
               INITIAL='Invoice due'
PYMIDUE  DFHMDF POS=(10,53),LENGTH=15,ATTRB=(ASKIP,NORM)
         DFHMDF POS=(12,1),LENGTH=8,ATTRB=(ASKIP,NORM),                X
               INITIAL='Money id'
PYMMNID  DFHMDF POS=(12,17),LENGTH=10,ATTRB=(ASKIP,BRT)
         DFHMDF POS=(12,32),LENGTH=6,ATTRB=(ASKIP,NORM),               X
               INITIAL='Status'
PYMSTAT  DFHMDF POS=(12,40),LENGTH=4,ATTRB=(ASKIP,BRT)
         DFHMDF POS=(13,1),LENGTH=11,ATTRB=(ASKIP,NORM),               X
               INITIAL='Distributed'
PYMDIST  DFHMDF POS=(13,17),LENGTH=15,ATTRB=(ASKIP,NORM)
         DFHMDF POS=(13,40),LENGTH=9,ATTRB=(ASKIP,NORM),               X
               INITIAL='Unapplied'
PYMUNAP  DFHMDF POS=(13,53),LENGTH=15,ATTRB=(ASKIP,NORM)
         DFHMDF POS=(15,3),LENGTH=44,ATTRB=(ASKIP,NORM),               X
               INITIAL='Item id     Invoice no        Amount applied'
PYMDLN   DFHMDF POS=(16,3),LENGTH=60,ATTRB=(ASKIP,NORM),OCCURS=6
PYMMSG   DFHMDF POS=(23,1),LENGTH=79,ATTRB=(ASKIP,BRT)
PYMPFK   DFHMDF POS=(24,1),LENGTH=79,ATTRB=(ASKIP,NORM),               X
               INITIAL='ENTER=Check PF5=Post PF3=Menu PF12=Clear'
*--- BILIVM  invoice list (12 rows)
BILIVM   DFHMDI SIZE=(24,80),LINE=1,COLUMN=1
         DFHMDF POS=(1,1),LENGTH=6,ATTRB=(ASKIP,NORM),INITIAL='BILIVM'
         DFHMDF POS=(1,12),LENGTH=17,ATTRB=(ASKIP,NORM),               X
               INITIAL='BillingCoreAJ2026'
         DFHMDF POS=(1,32),LENGTH=12,ATTRB=(ASKIP,BRT),                X
               INITIAL='INVOICE LIST'
IVMDATE  DFHMDF POS=(1,70),LENGTH=10,ATTRB=(ASKIP,NORM)
         DFHMDF POS=(3,1),LENGTH=7,ATTRB=(ASKIP,NORM),INITIAL='Account'
IVMACCT  DFHMDF POS=(3,9),LENGTH=10,ATTRB=(UNPROT,BRT,IC,FSET)
         DFHMDF POS=(3,20),LENGTH=1,ATTRB=(ASKIP,DRK)
IVMANAM  DFHMDF POS=(3,22),LENGTH=58,ATTRB=(ASKIP,BRT)
IVMPAGE  DFHMDF POS=(4,60),LENGTH=20,ATTRB=(ASKIP,NORM)
         DFHMDF POS=(5,1),LENGTH=33,ATTRB=(ASKIP,NORM),                X
               INITIAL='Invoice no    Bill date  Due date'
         DFHMDF POS=(5,37),LENGTH=42,ATTRB=(ASKIP,NORM),               X
               INITIAL='      Amount         Paid Stat Description'
IVMLN    DFHMDF POS=(6,1),LENGTH=79,ATTRB=(ASKIP,NORM),OCCURS=12
IVMMSG   DFHMDF POS=(23,1),LENGTH=79,ATTRB=(ASKIP,BRT)
IVMPFK   DFHMDF POS=(24,1),LENGTH=79,ATTRB=(ASKIP,NORM),               X
               INITIAL='PF3=Menu PF5=Pay PF7=Back PF8=Fwd'
         DFHMSD TYPE=FINAL
         END
