//BILACHRT JOB (BILB,0050),'DDEBIT RETURNS/SETTLE',CLASS=B,
//             MSGCLASS=X,NOTIFY=&SYSUID,REGION=0M
//*********************************************************************
//* BILLINGCOREAJ2026 - DIRECT DEBIT RETURNS AND SETTLEMENT (BILACHRT)*
//* RUNS AFTER THE BANK'S DAILY UNPAIDS FILE ARRIVES AND BEFORE      *
//* BILACHDR. A RETURNS FILE THAT DOES NOT PROVE ENDS RC 12 AND NO   *
//* DRAFT IS SETTLED (A RETURN MAY BE HIDDEN IN IT). AN EMPTY DAY    *
//* STILL NEEDS A HEADER AND A ZERO TRAILER FROM THE BANK.           *
//* RESTART: POINT RESTART AT THE PRIOR CHKPT GENERATION; THE RUN    *
//* RESUMES IN THE PHASE (R RETURNS / S SETTLE) AND AFTER THE KEY    *
//* LAST COMMITTED.                                                  *
//* PARM  : 1-4 COMMIT FREQ, 6-15 BUS DATE OVERRIDE, 17-18 RETURN    *
//*         WINDOW IN BUSINESS DAYS (DEFAULT 02)                     *
//*********************************************************************
//STEP010  EXEC PGM=IKJEFT01,DYNAMNBR=20
//STEPLIB  DD DSN=BIL.PROD.LOADLIB,DISP=SHR
//         DD DSN=DSNC10.SDSNLOAD,DISP=SHR
//SYSTSPRT DD SYSOUT=*
//SYSPRINT DD SYSOUT=*
//SYSOUT   DD SYSOUT=*
//SYSUDUMP DD SYSOUT=*
//RTNIN    DD DSN=BIL.PROD.DDEBIT.RETURNS(0),DISP=SHR
//RESTART  DD DUMMY,DCB=(RECFM=FB,LRECL=80,BLKSIZE=0)
//CHKPT    DD DSN=BIL.PROD.BILACHRT.CHKPT(+1),
//            DISP=(NEW,CATLG,DELETE),UNIT=SYSDA,
//            SPACE=(TRK,(5,5),RLSE),
//            DCB=(RECFM=FB,LRECL=80,BLKSIZE=0)
//RPTOUT   DD SYSOUT=*,DCB=(RECFM=FBA,LRECL=133)
//SYSTSIN  DD *
  DSN SYSTEM(DB2P)
  RUN PROGRAM(BILACHRT) PLAN(BILBATCH) -
      LIB('BIL.PROD.LOADLIB') -
      PARMS('0200            02')
  END
/*
