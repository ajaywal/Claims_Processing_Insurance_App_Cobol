//BILEVTDR JOB (BILB,0060),'EVENT DRAINER',CLASS=B,
//             MSGCLASS=X,NOTIFY=&SYSUID,REGION=0M
//*********************************************************************
//* BILLINGCOREAJ2026 - BILEVTDR                                      *
//* EVENT DRAINER: DELIVER TO CLM_EVENT_QUEUE, CANCREQ TO             *
//* OPERATIONS, PROCESS CLMPAYMT DEDBILL POL* INBOUND.                *
//* PARM   : 1-4 COMMIT FREQUENCY, 6-15 BUSINESS DATE OVERRIDE        *
//* OPSOUT : BILEVTO1 CANCREQ WORK FOR OPS                            *
//* CHKPT  : BILDSBK1 CHECKPOINT, NEW GDG GENERATION                  *
//* RC     : 0 OK, 4 WARNINGS, 8 REJECTS, 12 CONTROL, 16 ABEND        *
//*********************************************************************
//STEP010  EXEC PGM=IKJEFT01,DYNAMNBR=20
//STEPLIB  DD DSN=BIL.PROD.LOADLIB,DISP=SHR
//         DD DSN=DSNC10.SDSNLOAD,DISP=SHR
//SYSTSPRT DD SYSOUT=*
//SYSPRINT DD SYSOUT=*
//SYSOUT   DD SYSOUT=*
//SYSUDUMP DD SYSOUT=*
//OPSOUT   DD DSN=BIL.PROD.GENAPP.OPSWORK(+1),
//            DISP=(NEW,CATLG,DELETE),UNIT=SYSDA,
//            SPACE=(TRK,(5,5),RLSE),
//            DCB=(RECFM=FB,LRECL=120,BLKSIZE=0)
//CHKPT    DD DSN=BIL.PROD.BILEVTDR.CHKPT(+1),
//            DISP=(NEW,CATLG,CATLG),UNIT=SYSDA,
//            SPACE=(TRK,(1,1),RLSE),
//            DCB=(RECFM=FB,LRECL=80,BLKSIZE=0)
//RPTOUT   DD SYSOUT=*,DCB=(RECFM=FBA,LRECL=133)
//SYSTSIN  DD *
  DSN SYSTEM(DB2P)
  RUN PROGRAM(BILEVTDR) PLAN(BILBATCH) -
      LIB('BIL.PROD.LOADLIB') -
      PARMS('0100')
  END
/*
