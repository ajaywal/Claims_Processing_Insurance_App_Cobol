//BILAGERP JOB (BILB,0040),'RECEIVABLES AGING',CLASS=B,
//             MSGCLASS=X,NOTIFY=&SYSUID,REGION=0M
//*********************************************************************
//* BILLINGCOREAJ2026 - RECEIVABLES AGING REPORT (BILAGERP)           *
//* AGES OPEN BILLED/DUE ITEMS CURRENT/1-30/31-60/61-90/90+, TOTALS   *
//* BY PRODUCER WITHIN PRODUCT, TOP 20 DELINQUENT ACCOUNTS.           *
//* AGECSV : CSV EXTRACT (BILAGEC1) FOR FINANCE, NEW GDG GENERATION.  *
//* CHKPT  : BILEODK1 ONE-RECORD CHECKPOINT - KEEP DISP=OLD.          *
//* RESTART: READ-ONLY - RESUBMIT; REPORT AND CSV ARE REBUILT.        *
//* RC     : 0 OK, 4 WARNINGS, 12 CSV/REPORT TOTALS DISAGREE, 16 ABEND*
//*********************************************************************
//STEP010  EXEC PGM=IKJEFT01,DYNAMNBR=20
//STEPLIB  DD DSN=BIL.PROD.LOADLIB,DISP=SHR
//         DD DSN=DSNC10.SDSNLOAD,DISP=SHR
//SYSTSPRT DD SYSOUT=*
//SYSPRINT DD SYSOUT=*
//SYSOUT   DD SYSOUT=*
//SYSUDUMP DD SYSOUT=*
//CHKPT    DD DSN=BIL.PROD.BILAGERP.CHKPT,DISP=OLD,
//            DCB=(RECFM=FB,LRECL=80,BLKSIZE=0)
//AGERPT   DD SYSOUT=*,DCB=(RECFM=FBA,LRECL=133)
//AGECSV   DD DSN=BIL.PROD.AGING.CSV(+1),
//            DISP=(NEW,CATLG,DELETE),UNIT=SYSDA,
//            SPACE=(CYL,(2,2),RLSE),
//            DCB=(RECFM=FB,LRECL=200,BLKSIZE=0)
//SYSTSIN  DD *
  DSN SYSTEM(DB2P)
  RUN PROGRAM(BILAGERP) PLAN(BILBATCH) -
      LIB('BIL.PROD.LOADLIB')
  END
/*
