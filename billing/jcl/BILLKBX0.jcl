//BILLKBX0 JOB (BILB,0030),'LOCKBOX POSTING',CLASS=B,
//             MSGCLASS=X,NOTIFY=&SYSUID,REGION=0M
//*********************************************************************
//* BILLINGCOREAJ2026 - BANK LOCKBOX RECEIPT POSTING (BILLKBX0)      *
//* LKBXIN IS THE BANK'S LOCKBOX FILE FOR ONE DEPOSIT (FB 120). THE  *
//* WHOLE FILE IS PROVED AGAINST ITS TRAILER BEFORE ANY POSTING; A   *
//* FILE THAT DOES NOT PROVE ENDS RC 12 WITH NOTHING POSTED.         *
//* RESTART: POINT RESTART AT THE PRIOR RUN'S CHKPT DATASET AND RERUN*
//* WITH THE SAME LKBXIN; POSTING RESUMES AFTER THE LAST COMMITTED   *
//* DETAIL SEQUENCE. COLD START: RESTART DD DUMMY.                   *
//* PARM  : 1-4 COMMIT FREQ, 6-15 BUSINESS DATE OVERRIDE             *
//* RC    : 0 OK, 4 SUSPENSE/HELD, 8 REJECTS, 12 FILE REJECTED,      *
//*         16 ABEND                                                 *
//*********************************************************************
//STEP010  EXEC PGM=IKJEFT01,DYNAMNBR=20
//STEPLIB  DD DSN=BIL.PROD.LOADLIB,DISP=SHR
//         DD DSN=DSNC10.SDSNLOAD,DISP=SHR
//SYSTSPRT DD SYSOUT=*
//SYSPRINT DD SYSOUT=*
//SYSOUT   DD SYSOUT=*
//SYSUDUMP DD SYSOUT=*
//LKBXIN   DD DSN=BIL.PROD.LOCKBOX.INBOUND(0),DISP=SHR
//RESTART  DD DUMMY,DCB=(RECFM=FB,LRECL=80,BLKSIZE=0)
//CHKPT    DD DSN=BIL.PROD.BILLKBX0.CHKPT(+1),
//            DISP=(NEW,CATLG,DELETE),UNIT=SYSDA,
//            SPACE=(TRK,(5,5),RLSE),
//            DCB=(RECFM=FB,LRECL=80,BLKSIZE=0)
//RPTOUT   DD SYSOUT=*,DCB=(RECFM=FBA,LRECL=133)
//SYSTSIN  DD *
  DSN SYSTEM(DB2P)
  RUN PROGRAM(BILLKBX0) PLAN(BILBATCH) -
      LIB('BIL.PROD.LOADLIB') -
      PARMS('0200')
  END
/*
