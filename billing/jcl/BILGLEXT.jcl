//BILGLEXT JOB (BILB,0040),'GENERAL LEDGER EXTRACT',CLASS=B,
//             MSGCLASS=X,NOTIFY=&SYSUID,REGION=0M
//*********************************************************************
//* BILLINGCOREAJ2026 - GENERAL-LEDGER EXTRACT (BILGLEXT)             *
//* SUMMARISES THE BUSINESS DATE LEDGER LINES BY GL ACCOUNT AND       *
//* COST CENTRE INTO GLEXT (BILGLEG1, H/D/T, FB 120) WITH DR, CR      *
//* AND ACCOUNT HASH TOTALS. NEEDS BATCH_STATUS B (RUN INSIDE BILEOD  *
//* OR AFTER BILEODDR MODE=BEGIN). NOTHING IS MARKED EXTRACTED.       *
//* RESTART: DELETE THE PARTIAL GLEXT GENERATION AND RESUBMIT.        *
//* RC     : 0 OK, 4 EMPTY DAY / UNMAPPED, 8 OUT OF BALANCE,          *
//*          12 WRONG BATCH STATUS, 16 ABEND                          *
//*********************************************************************
//STEP010  EXEC PGM=IKJEFT01,DYNAMNBR=20
//STEPLIB  DD DSN=BIL.PROD.LOADLIB,DISP=SHR
//         DD DSN=DSNC10.SDSNLOAD,DISP=SHR
//SYSTSPRT DD SYSOUT=*
//SYSPRINT DD SYSOUT=*
//SYSOUT   DD SYSOUT=*
//SYSUDUMP DD SYSOUT=*
//CHKPT    DD DSN=BIL.PROD.BILGLEXT.CHKPT,DISP=OLD,
//            DCB=(RECFM=FB,LRECL=80,BLKSIZE=0)
//GLXRPT   DD SYSOUT=*,DCB=(RECFM=FBA,LRECL=133)
//GLEXT    DD DSN=BIL.PROD.GL.INTERFACE(+1),
//            DISP=(NEW,CATLG,DELETE),UNIT=SYSDA,
//            SPACE=(CYL,(1,1),RLSE),
//            DCB=(RECFM=FB,LRECL=120,BLKSIZE=0)
//SYSTSIN  DD *
  DSN SYSTEM(DB2P)
  RUN PROGRAM(BILGLEXT) PLAN(BILBATCH) -
      LIB('BIL.PROD.LOADLIB')
  END
/*
