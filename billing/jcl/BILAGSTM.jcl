//BILAGSTM JOB (BILB,0060),'AGENCY STMTS',CLASS=B,
//             MSGCLASS=X,NOTIFY=&SYSUID,REGION=0M
//*********************************************************************
//* BILLINGCOREAJ2026 - BILAGSTM                                      *
//* AGENCY-BILL PRODUCER STATEMENTS: GROSS, COMMISSION,               *
//* NET DUE ON AB PERIODS SINCE THE LAST STATEMENT.                   *
//* PARM   : 1-4 COMMIT FREQUENCY, 6-15 BUSINESS DATE OVERRIDE        *
//* RESTART: RERUN: BIL.PROD.BILAGSTM.CHKPT(0)                        *
//* STMTOUT: BILAGSS1 STATEMENT FILE                                  *
//* CHKPT  : BILDSBK1 CHECKPOINT, NEW GDG GENERATION                  *
//* RC     : 0 OK, 4 WARNINGS, 8 REJECTS, 12 CONTROL, 16 ABEND        *
//*********************************************************************
//STEP010  EXEC PGM=IKJEFT01,DYNAMNBR=20
//STEPLIB  DD DSN=BIL.PROD.LOADLIB,DISP=SHR
//         DD DSN=DSNC10.SDSNLOAD,DISP=SHR
//SYSTSPRT DD SYSOUT=*
//SYSPRINT DD SYSOUT=*
//SYSOUT   DD SYSOUT=*
//SYSUDUMP DD SYSOUT=*
//RESTART  DD DUMMY,DCB=(RECFM=FB,LRECL=80)
//STMTOUT  DD DSN=BIL.PROD.AGENCY.STMTS(+1),
//            DISP=(NEW,CATLG,DELETE),UNIT=SYSDA,
//            SPACE=(CYL,(5,5),RLSE),
//            DCB=(RECFM=FB,LRECL=200,BLKSIZE=0)
//CHKPT    DD DSN=BIL.PROD.BILAGSTM.CHKPT(+1),
//            DISP=(NEW,CATLG,CATLG),UNIT=SYSDA,
//            SPACE=(TRK,(1,1),RLSE),
//            DCB=(RECFM=FB,LRECL=80,BLKSIZE=0)
//RPTOUT   DD SYSOUT=*,DCB=(RECFM=FBA,LRECL=133)
//SYSTSIN  DD *
  DSN SYSTEM(DB2P)
  RUN PROGRAM(BILAGSTM) PLAN(BILBATCH) -
      LIB('BIL.PROD.LOADLIB') -
      PARMS('0050')
  END
/*
