//BILACHDR JOB (BILB,0040),'DIRECT DEBIT DRAFTS',CLASS=B,
//             MSGCLASS=X,NOTIFY=&SYSUID,REGION=0M
//*********************************************************************
//* BILLINGCOREAJ2026 - DIRECT DEBIT DRAFT GENERATION (BILACHDR)     *
//* PHASE 1 RAISES PAYMENT REQUESTS (CRTD) FOR AUTOPAY INVOICES DUE  *
//* WITHIN THE HORIZON; PHASE 2 WRITES ALL CRTD REQUESTS TO DRAFTOUT *
//* AND MARKS THEM SENT IN ONE UNIT OF WORK. DRAFTOUT IS A NEW GDG   *
//* GENERATION PICKED UP BY THE BANK TRANSMISSION JOB.               *
//* RESTART: POINT RESTART AT THE PRIOR CHKPT GENERATION AND RERUN.  *
//* A DRAFTOUT FROM AN ABENDED RUN HAS NO TRAILER - DELETE IT, THE   *
//* RERUN REWRITES EVERY UNSENT REQUEST.                             *
//* PARM  : 1-4 COMMIT FREQ, 6-15 BUS DATE OVERRIDE, 17-18 HORIZON   *
//*         BUSINESS DAYS, 20-25 BACS SERVICE USER NUMBER            *
//*********************************************************************
//STEP010  EXEC PGM=IKJEFT01,DYNAMNBR=20
//STEPLIB  DD DSN=BIL.PROD.LOADLIB,DISP=SHR
//         DD DSN=DSNC10.SDSNLOAD,DISP=SHR
//SYSTSPRT DD SYSOUT=*
//SYSPRINT DD SYSOUT=*
//SYSOUT   DD SYSOUT=*
//SYSUDUMP DD SYSOUT=*
//RESTART  DD DUMMY,DCB=(RECFM=FB,LRECL=80,BLKSIZE=0)
//CHKPT    DD DSN=BIL.PROD.BILACHDR.CHKPT(+1),
//            DISP=(NEW,CATLG,DELETE),UNIT=SYSDA,
//            SPACE=(TRK,(5,5),RLSE),
//            DCB=(RECFM=FB,LRECL=80,BLKSIZE=0)
//DRAFTOUT DD DSN=BIL.PROD.DDEBIT.OUTBOUND(+1),
//            DISP=(NEW,CATLG,DELETE),UNIT=SYSDA,
//            SPACE=(CYL,(2,2),RLSE),
//            DCB=(RECFM=FB,LRECL=120,BLKSIZE=0)
//RPTOUT   DD SYSOUT=*,DCB=(RECFM=FBA,LRECL=133)
//SYSTSIN  DD *
  DSN SYSTEM(DB2P)
  RUN PROGRAM(BILACHDR) PLAN(BILBATCH) -
      LIB('BIL.PROD.LOADLIB') -
      PARMS('0200            03 412345')
  END
/*
