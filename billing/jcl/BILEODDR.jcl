//BILEODDR JOB (BILB,0040),'END OF DAY CONTROL',CLASS=B,
//             MSGCLASS=X,NOTIFY=&SYSUID,REGION=0M
//*********************************************************************
//* BILLINGCOREAJ2026 - END-OF-DAY CONTROL (BILEODDR), STANDALONE     *
//* NORMALLY RUN AS STEPS EODBEGIN / EODEND OF JOB BILEOD. USE THIS   *
//* JOB ONLY TO COMPLETE A NIGHT BY HAND: CTLCARD MODE=BEGIN OPENS    *
//* THE WINDOW (STATUS O->B); MODE=END CHECKS EOD.STEPSTAT AND ROLLS  *
//* THE BUSINESS DATE TO THE NEXT BUSINESS DAY (STATUS B->O).         *
//* RC     : 0 OK, 4 RESTART / WARNINGS, 12 HALTED (DATE NOT ROLLED), *
//*          16 ABEND                                                 *
//*********************************************************************
//STEP010  EXEC PGM=IKJEFT01,DYNAMNBR=20
//STEPLIB  DD DSN=BIL.PROD.LOADLIB,DISP=SHR
//         DD DSN=DSNC10.SDSNLOAD,DISP=SHR
//SYSTSPRT DD SYSOUT=*
//SYSPRINT DD SYSOUT=*
//SYSOUT   DD SYSOUT=*
//SYSUDUMP DD SYSOUT=*
//CHKPT    DD DSN=BIL.PROD.BILEODDR.CHKPT,DISP=OLD,
//            DCB=(RECFM=FB,LRECL=80,BLKSIZE=0)
//EODRPT   DD SYSOUT=*,DCB=(RECFM=FBA,LRECL=133)
//STEPSTAT DD DSN=BIL.PROD.EOD.STEPSTAT,DISP=SHR
//CTLCARD  DD *
MODE=END
/*
//SYSTSIN  DD *
  DSN SYSTEM(DB2P)
  RUN PROGRAM(BILEODDR) PLAN(BILBATCH) -
      LIB('BIL.PROD.LOADLIB')
  END
/*
