//BILCSD   JOB (BILB,0040),'BILLING CSD DEFINES',CLASS=A,
//             MSGCLASS=X,NOTIFY=&SYSUID,REGION=0M
//*********************************************************************
//* BILLINGCOREAJ2026 - CICS RESOURCE DEFINITIONS (DFHCSDUP)          *
//* GROUP BILSCRN : MAPSET BILMSET, THE FOUR SCREEN PROGRAMS AND      *
//*                 THEIR TRANSACTIONS BMNU BACI BPAY BIVL.           *
//* GROUP BILSERV : STYLE-A SERVICES THE SCREENS LINK TO.             *
//* BOTH GROUPS ARE ADDED TO LIST BILLIST; INSTALL WITH               *
//*   CEDA INSTALL GROUP(BILSCRN) / GROUP(BILSERV)  OR COLD START     *
//*   WITH GRPLIST=(DFHLIST,BILLIST).                                 *
//* DB2: ENTRY BILDB2E (PLAN BILONLN) IS USED BY EVERY TRANSACTION    *
//* THAT REACHES DB2 THROUGH A LINKED SERVICE.                        *
//* RERUNNABLE: DELETE THEN DEFINE.                                   *
//*********************************************************************
//CSDUP    EXEC PGM=DFHCSDUP,REGION=0M,
//             PARM='CSD(READWRITE),PAGESIZE(60),NOCOMPAT'
//STEPLIB  DD DSN=DFH610.CICS.SDFHLOAD,DISP=SHR
//DFHCSD   DD DSN=CICSP.BIL.DFHCSD,DISP=SHR
//SYSPRINT DD SYSOUT=*
//SYSIN    DD *
*--------------------------------------------------------------------
* REMOVE THE PREVIOUS DEFINITIONS (RC 4 ON A FIRST RUN IS EXPECTED)
*--------------------------------------------------------------------
 DELETE GROUP(BILSCRN)
 DELETE GROUP(BILSERV)
*--------------------------------------------------------------------
* MAPSET
*--------------------------------------------------------------------
 DEFINE MAPSET(BILMSET) GROUP(BILSCRN)
        DESCRIPTION(BILLINGCORE MENU ACCOUNT PAYMENT INVOICE MAPS)
        RESIDENT(NO) USAGE(NORMAL) USELPACOPY(NO) STATUS(ENABLED)
*--------------------------------------------------------------------
* SCREEN PROGRAMS (STYLE B, PSEUDO-CONVERSATIONAL)
*--------------------------------------------------------------------
 DEFINE PROGRAM(BILMNUP) GROUP(BILSCRN)
        DESCRIPTION(BILLINGCORE MAIN MENU)
        LANGUAGE(LE370) DATALOCATION(ANY) EXECKEY(USER)
        CONCURRENCY(QUASIRENT) STATUS(ENABLED)
 DEFINE PROGRAM(BILACIP) GROUP(BILSCRN)
        DESCRIPTION(BILLINGCORE ACCOUNT SUMMARY)
        LANGUAGE(LE370) DATALOCATION(ANY) EXECKEY(USER)
        CONCURRENCY(QUASIRENT) STATUS(ENABLED)
 DEFINE PROGRAM(BILPAYP) GROUP(BILSCRN)
        DESCRIPTION(BILLINGCORE PAYMENT ENTRY)
        LANGUAGE(LE370) DATALOCATION(ANY) EXECKEY(USER)
        CONCURRENCY(QUASIRENT) STATUS(ENABLED)
 DEFINE PROGRAM(BILIVMP) GROUP(BILSCRN)
        DESCRIPTION(BILLINGCORE INVOICE LIST)
        LANGUAGE(LE370) DATALOCATION(ANY) EXECKEY(USER)
        CONCURRENCY(QUASIRENT) STATUS(ENABLED)
*--------------------------------------------------------------------
* TRANSACTIONS
*--------------------------------------------------------------------
 DEFINE TRANSACTION(BMNU) GROUP(BILSCRN) PROGRAM(BILMNUP)
        DESCRIPTION(BILLINGCORE MAIN MENU)
        TWASIZE(0) PROFILE(DFHCICST) STATUS(ENABLED)
        TASKDATALOC(ANY) TASKDATAKEY(USER) RESSEC(YES) CMDSEC(NO)
        DTIMOUT(NO) SPURGE(YES) TPURGE(YES)
 DEFINE TRANSACTION(BACI) GROUP(BILSCRN) PROGRAM(BILACIP)
        DESCRIPTION(BILLINGCORE ACCOUNT INQUIRY)
        TWASIZE(0) PROFILE(DFHCICST) STATUS(ENABLED)
        TASKDATALOC(ANY) TASKDATAKEY(USER) RESSEC(YES) CMDSEC(NO)
        DTIMOUT(NO) SPURGE(YES) TPURGE(YES)
 DEFINE TRANSACTION(BPAY) GROUP(BILSCRN) PROGRAM(BILPAYP)
        DESCRIPTION(BILLINGCORE PAYMENT ENTRY)
        TWASIZE(0) PROFILE(DFHCICST) STATUS(ENABLED)
        TASKDATALOC(ANY) TASKDATAKEY(USER) RESSEC(YES) CMDSEC(NO)
        DTIMOUT(NO) SPURGE(NO) TPURGE(NO)
 DEFINE TRANSACTION(BIVL) GROUP(BILSCRN) PROGRAM(BILIVMP)
        DESCRIPTION(BILLINGCORE INVOICE LIST)
        TWASIZE(0) PROFILE(DFHCICST) STATUS(ENABLED)
        TASKDATALOC(ANY) TASKDATAKEY(USER) RESSEC(YES) CMDSEC(NO)
        DTIMOUT(NO) SPURGE(YES) TPURGE(YES)
*--------------------------------------------------------------------
* STYLE-A SERVICES LINKED BY THE SCREENS
*--------------------------------------------------------------------
 DEFINE PROGRAM(BILACCT0) GROUP(BILSERV)
        DESCRIPTION(BILLING ACCOUNT SERVICE)
        LANGUAGE(LE370) DATALOCATION(ANY) CONCURRENCY(THREADSAFE)
 DEFINE PROGRAM(BILPAYRC) GROUP(BILSERV)
        DESCRIPTION(PAYMENT RECEIPT SERVICE)
        LANGUAGE(LE370) DATALOCATION(ANY) CONCURRENCY(THREADSAFE)
 DEFINE PROGRAM(BILINVSV) GROUP(BILSERV)
        DESCRIPTION(INVOICE SERVICE)
        LANGUAGE(LE370) DATALOCATION(ANY) CONCURRENCY(THREADSAFE)
 DEFINE PROGRAM(BILCODVL) GROUP(BILSERV)
        DESCRIPTION(CODE TABLE VALIDATION)
        LANGUAGE(LE370) DATALOCATION(ANY) CONCURRENCY(THREADSAFE)
 DEFINE PROGRAM(BILDATES) GROUP(BILSERV)
        DESCRIPTION(DATE ARITHMETIC)
        LANGUAGE(LE370) DATALOCATION(ANY) CONCURRENCY(THREADSAFE)
 DEFINE PROGRAM(BILERRLG) GROUP(BILSERV)
        DESCRIPTION(ERROR LOG)
        LANGUAGE(LE370) DATALOCATION(ANY) CONCURRENCY(THREADSAFE)
*--------------------------------------------------------------------
* DB2 ATTACHMENT FOR THE SCREEN TRANSACTIONS
*--------------------------------------------------------------------
 DEFINE DB2ENTRY(BILDB2E) GROUP(BILSCRN)
        DESCRIPTION(BILLINGCORE ONLINE PLAN)
        TRANSID(BMNU) PLAN(BILONLN) AUTHTYPE(USERID)
        ACCOUNTREC(TXID) THREADLIMIT(20) THREADWAIT(POOL)
        PRIORITY(HIGH) PROTECTNUM(5) DROLLBACK(YES)
 DEFINE DB2TRAN(BILBACI) GROUP(BILSCRN) ENTRY(BILDB2E)
        TRANSID(BACI)
 DEFINE DB2TRAN(BILBPAY) GROUP(BILSCRN) ENTRY(BILDB2E)
        TRANSID(BPAY)
 DEFINE DB2TRAN(BILBIVL) GROUP(BILSCRN) ENTRY(BILDB2E)
        TRANSID(BIVL)
*--------------------------------------------------------------------
 ADD GROUP(BILSCRN) LIST(BILLIST)
 ADD GROUP(BILSERV) LIST(BILLIST)
 LIST GROUP(BILSCRN) OBJECTS
/*
//
