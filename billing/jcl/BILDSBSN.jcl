//BILDSBSN JOB (BILB,0060),'DISB SEND',CLASS=B,
//             MSGCLASS=X,NOTIFY=&SYSUID,REGION=0M
//*********************************************************************
//* BILLINGCOREAJ2026 - BILDSBSN                                      *
//* DISBURSEMENT SEND: APPR -> SENT, DR DISBPAY / CR CASH,            *
//* DSBSENT TO CLAIMS, PAYMENTS FILE REBUILT EACH RUN.                *
//* PARM   : 1-4 COMMIT FREQUENCY, 6-15 BUSINESS DATE OVERRIDE        *
//* RESTART: RERUN: BIL.PROD.BILDSBSN.CHKPT(0)                        *
//* PAYFILE: BILDSBP1 CHEQUE/BACS BUREAU FILE                         *
//* CHKPT  : BILDSBK1 CHECKPOINT, NEW GDG GENERATION                  *
//* RC     : 0 OK, 4 WARNINGS, 8 REJECTS, 12 CONTROL, 16 ABEND        *
//*********************************************************************
//STEP010  EXEC PGM=IKJEFT01,DYNAMNBR=20
//STEPLIB  DD DSN=BIL.PROD.LOADLIB,DISP=SHR
//         DD DSN=DSNC10.SDSNLOAD,DISP=SHR
//SYSTSPRT DD SYSOUT=*
//SYSPRINT DD SYSOUT=*
//SYSOUT   DD SYSOUT=*
//SYSUDUMP DD SYSOUT=*
//RESTART  DD DUMMY,DCB=(RECFM=FB,LRECL=80)
//PAYFILE  DD DSN=BIL.PROD.PAYMENTS.BUREAU(+1),
//            DISP=(NEW,CATLG,DELETE),UNIT=SYSDA,
//            SPACE=(CYL,(5,5),RLSE),
//            DCB=(RECFM=FB,LRECL=250,BLKSIZE=0)
//CHKPT    DD DSN=BIL.PROD.BILDSBSN.CHKPT(+1),
//            DISP=(NEW,CATLG,CATLG),UNIT=SYSDA,
//            SPACE=(TRK,(1,1),RLSE),
//            DCB=(RECFM=FB,LRECL=80,BLKSIZE=0)
//RPTOUT   DD SYSOUT=*,DCB=(RECFM=FBA,LRECL=133)
//SYSTSIN  DD *
  DSN SYSTEM(DB2P)
  RUN PROGRAM(BILDSBSN) PLAN(BILBATCH) -
      LIB('BIL.PROD.LOADLIB') -
      PARMS('0200')
  END
/*
