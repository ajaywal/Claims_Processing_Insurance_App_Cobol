//BILDOCGN JOB (BILB,0040),'DOCUMENT EXTRACT',CLASS=B,
//             MSGCLASS=X,NOTIFY=&SYSUID,REGION=0M
//*********************************************************************
//* BILLINGCOREAJ2026 - DOCUMENT EXTRACT TO PRINT VENDOR (BILDOCGN)  *
//* WRITES EVERY RQST DOCUMENT REQUEST TO PRTVEND (BILDOCP1, H/D/T   *
//* RECORDS) AND MARKS IT SENT; UNADDRESSABLE REQUESTS GO TO ERRR.   *
//* PRTVEND FROM AN ABENDED RUN IS INCOMPLETE - DELETE IT AND RERUN; *
//* THE RESTART REWRITES EVERYTHING THE FAILED RUN ALREADY SENT.     *
//* LAST STEP OF THE BILLING CYCLE, FEEDS THE VENDOR TRANSMISSION.   *
//* SYSIN : BILINVC1 CONTROL CARD - 1-10 BUS DATE OVERRIDE (BLANK =  *
//*         BIL_CONTROL SYSTEM), 11-14 COMMIT FREQ (BLANK = 200),    *
//*         15 RESTART MODE (BLANK AUTO, N IGNORE CHKPT, F FORCE)    *
//* CHKPT : BILINVK1 ONE-RECORD CHECKPOINT (LRECL 106), READ AT      *
//*         START AND REWRITTEN AT EVERY COMMIT - KEEP DISP=OLD.     *
//* RC    : 0 OK, 4 WARNINGS, 8 REJECTS (SEE RPTOUT), 16 ABEND -     *
//*         RESUBMIT UNCHANGED TO RESTART FROM THE CHECKPOINT.       *
//*********************************************************************
//STEP010  EXEC PGM=IKJEFT01,DYNAMNBR=20
//STEPLIB  DD DSN=BIL.PROD.LOADLIB,DISP=SHR
//         DD DSN=DSNC10.SDSNLOAD,DISP=SHR
//SYSTSPRT DD SYSOUT=*
//SYSPRINT DD SYSOUT=*
//SYSOUT   DD SYSOUT=*
//SYSUDUMP DD SYSOUT=*
//CHKPT    DD DSN=BIL.PROD.BILDOCGN.CHKPT,DISP=OLD,
//            DCB=(RECFM=FB,LRECL=106,BLKSIZE=0)
//PRTVEND  DD DSN=BIL.PROD.PRTVEND.OUTBOUND(+1),
//            DISP=(NEW,CATLG,DELETE),UNIT=SYSDA,
//            SPACE=(CYL,(5,5),RLSE),
//            DCB=(RECFM=FB,LRECL=500,BLKSIZE=0)
//RPTOUT   DD SYSOUT=*,DCB=(RECFM=FBA,LRECL=133)
//SYSIN    DD *

/*
//SYSTSIN  DD *
  DSN SYSTEM(DB2P)
  RUN PROGRAM(BILDOCGN) PLAN(BILBATCH) -
      LIB('BIL.PROD.LOADLIB')
  END
/*
