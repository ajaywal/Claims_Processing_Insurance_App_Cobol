//BILEOD   JOB (BILB,0040),'BILLING END OF DAY',CLASS=B,
//             MSGCLASS=X,NOTIFY=&SYSUID,REGION=0M
//*********************************************************************
//* BILLINGCOREAJ2026 - NIGHTLY END-OF-DAY JOB STREAM (BILEOD)        *
//* EODBEGIN  BILEODDR MODE=BEGIN: BATCH_STATUS O -> B (ONLINE DAY    *
//*           CLOSED TO POSTING). RC 12 STOPS THE WHOLE STREAM.       *
//* 16 STEPS  EACH RUNS ONLY IF EVERY EARLIER STEP ENDED RC < 8 AND   *
//*           NOTHING ABENDED. AFTER EACH STEP ONE STEPST STEP        *
//*           APPENDS '<PROGRAM> <RC CLASS>' TO EOD.STEPSTAT:         *
//*           00 CLEAN, 04 WARNINGS (RC 1-7), 08 FAILED (RC 8+),      *
//*           99 ABEND.                                               *
//* EODEND    BILEODDR MODE=END (COND=EVEN, ALWAYS RUNS): CHECKS      *
//*           STEPSTAT, AUDITS EACH RESULT, STOPS AT THE FIRST        *
//*           FAILED / MISSING STEP (STATUS STAYS B, RC 12), ELSE     *
//*           ROLLS BUSINESS_DATE TO THE NEXT BUSINESS DAY, STATUS O. *
//* RESTART : FIX THE CAUSE, THEN RESUBMIT WITH RESTART=<FAILED STEP> *
//*           ON THE JOB CARD. STEPSTAT IS NOT RESET ON A RESTART -   *
//*           NEW RESULTS ARE APPENDED AND THE LATEST ONE PER STEP    *
//*           WINS. EODBEGIN ACCEPTS A RERUN FOR THE SAME DATE (RC 4) *
//*           AND EODEND NEVER ROLLS THE DATE TWICE.                  *
//* A RECONCILIATION BREAK (RECON RC 8) DELIBERATELY HOLDS THE GL     *
//* EXTRACT AND THE DATE ROLL UNTIL FINANCE HAS CLEARED IT.           *
//*********************************************************************
//*
//*--- DSN RUN OF A BILLING BATCH PROGRAM UNDER THE TSO TMP
//BILRUN   PROC PGM=,PRM=
//RUN      EXEC PGM=IKJEFT01,DYNAMNBR=20
//STEPLIB  DD DSN=BIL.PROD.LOADLIB,DISP=SHR
//         DD DSN=DSNC10.SDSNLOAD,DISP=SHR
//SYSTSPRT DD SYSOUT=*
//SYSPRINT DD SYSOUT=*
//SYSOUT   DD SYSOUT=*
//SYSUDUMP DD SYSOUT=*
//RPTOUT   DD SYSOUT=*,DCB=(RECFM=FBA,LRECL=133)
//SYSTSIN  DD *,SYMBOLS=JCLONLY
  DSN SYSTEM(DB2P)
  RUN PROGRAM(&PGM) PLAN(BILBATCH) -
      LIB('BIL.PROD.LOADLIB') PARMS('&PRM')
  END
/*
//         PEND
//*
//*--- APPEND ONE STEP RESULT TO THE STEP-STATUS FILE (BILEODS1)
//STEPST   PROC S=,R=
//WRITE    EXEC PGM=IEBGENER
//SYSPRINT DD DUMMY
//SYSIN    DD DUMMY
//SYSUT2   DD DSN=BIL.PROD.EOD.STEPSTAT,DISP=MOD
//SYSUT1   DD *,SYMBOLS=JCLONLY
&S &R
/*
//         PEND
//*
//*--- NEW NIGHT: EMPTY STEP-STATUS FILE (SKIPPED ON A RESTART)
//EODDEL   EXEC PGM=IEFBR14
//STEPSTAT DD DSN=BIL.PROD.EOD.STEPSTAT,DISP=(MOD,DELETE,DELETE),
//            UNIT=SYSDA,SPACE=(TRK,(1,1))
//EODALLOC EXEC PGM=IEFBR14
//STEPSTAT DD DSN=BIL.PROD.EOD.STEPSTAT,DISP=(NEW,CATLG,DELETE),
//            UNIT=SYSDA,SPACE=(TRK,(1,1),RLSE),
//            DCB=(RECFM=FB,LRECL=80,BLKSIZE=0)
//*
//*--- OPEN THE END-OF-DAY WINDOW
//EODBEGIN EXEC BILRUN,PGM=BILEODDR
//RUN.CHKPT DD DSN=BIL.PROD.BILEODDR.CHKPT,DISP=OLD,
//            DCB=(RECFM=FB,LRECL=80,BLKSIZE=0)
//RUN.EODRPT DD SYSOUT=*,DCB=(RECFM=FBA,LRECL=133)
//RUN.STEPSTAT DD DUMMY,DCB=(RECFM=FB,LRECL=80,BLKSIZE=0)
//RUN.CTLCARD DD *
