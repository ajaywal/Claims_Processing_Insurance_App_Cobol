//BILRECON JOB (BILB,0040),'LEDGER RECONCILIATION',CLASS=B,
//             MSGCLASS=X,NOTIFY=&SYSUID,REGION=0M
//*********************************************************************
//* BILLINGCOREAJ2026 - LEDGER RECONCILIATION (BILRECON)              *
//* TRIAL BALANCE PER T-ACCOUNT (DAY AND TO DATE), ZERO PROOF,        *
//* UNBALANCED / UNPOSTED TRANSACTIONS, SUB-LEDGER TO CONTROL         *
//* ACCOUNT BREAKS, ACCOUNT BALANCE CACHE WARNINGS.                   *
//* CHKPT  : BILEODK1 ONE-RECORD CHECKPOINT - KEEP DISP=OLD.          *
//* RESTART: READ-ONLY - RESUBMIT.                                    *
//* RC     : 0 RECONCILED, 4 CACHE WARNINGS, 8 BREAKS, 16 ABEND       *
//*********************************************************************
//STEP010  EXEC PGM=IKJEFT01,DYNAMNBR=20
//STEPLIB  DD DSN=BIL.PROD.LOADLIB,DISP=SHR
//         DD DSN=DSNC10.SDSNLOAD,DISP=SHR
//SYSTSPRT DD SYSOUT=*
//SYSPRINT DD SYSOUT=*
//SYSOUT   DD SYSOUT=*
//SYSUDUMP DD SYSOUT=*
//CHKPT    DD DSN=BIL.PROD.BILRECON.CHKPT,DISP=OLD,
//            DCB=(RECFM=FB,LRECL=80,BLKSIZE=0)
//RECRPT   DD SYSOUT=*,DCB=(RECFM=FBA,LRECL=133)
//SYSTSIN  DD *
  DSN SYSTEM(DB2P)
  RUN PROGRAM(BILRECON) PLAN(BILBATCH) -
      LIB('BIL.PROD.LOADLIB')
  END
/*
