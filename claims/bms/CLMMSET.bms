***********************************************************************
* CLMMSET  - ClaimsCoreAJ2026 3270 online mapset (style B screens)
*           CLMMNU menu, CLMFNM FNOL entry, CLMIQM claim summary,
*           CLMFTM financials, CLMAVM activity list
* Used by   CLMMNUP CLMFNLP CLMINQP CLMFINP CLMACTP
* Assemble  TYPE=MAP (physical) and TYPE=DSECT (symbolic);
*           symbolic map is generated by tools/bmsgen.py
* Input fields carry FSET so every RECEIVE MAP returns them all;
* CTRL omits FRSET for the same reason.
* Change log 2026-10-27 AJ  Initial version
***********************************************************************
CLMMSET  DFHMSD TYPE=&SYSPARM,MODE=INOUT,LANG=COBOL,STORAGE=AUTO,      X
               TIOAPFX=YES,CTRL=(FREEKB),MAPATTS=(COLOR,HILIGHT),      X
               TERM=3270-2
*----------------------------------------------------------------------
* CLMMNU
*----------------------------------------------------------------------
CLMMNU   DFHMDI SIZE=(24,80),LINE=1,COLUMN=1
         DFHMDF POS=(1,1),LENGTH=6,ATTRB=ASKIP,COLOR=BLUE,             X
               INITIAL='CLMMNU'
         DFHMDF POS=(1,22),LENGTH=35,ATTRB=(ASKIP,BRT),COLOR=WHITE,    X
               INITIAL='ClaimsCoreAJ2026 - Claims Main Menu'
MDATE    DFHMDF POS=(1,69),LENGTH=10,ATTRB=ASKIP,COLOR=TURQUOISE
         DFHMDF POS=(3,1),LENGTH=5,ATTRB=ASKIP,COLOR=BLUE,             X
               INITIAL='User:'
MUSER    DFHMDF POS=(3,7),LENGTH=8,ATTRB=ASKIP,COLOR=TURQUOISE
         DFHMDF POS=(3,60),LENGTH=9,ATTRB=ASKIP,COLOR=BLUE,            X
               INITIAL='Terminal:'
MTERM    DFHMDF POS=(3,71),LENGTH=4,ATTRB=ASKIP,COLOR=TURQUOISE
         DFHMDF POS=(6,10),LENGTH=41,ATTRB=ASKIP,COLOR=NEUTRAL,        X
               INITIAL='1  First notice of loss (FNOL)       CFNL'
         DFHMDF POS=(7,10),LENGTH=41,ATTRB=ASKIP,COLOR=NEUTRAL,        X
               INITIAL='2  Claim inquiry                     CINQ'
         DFHMDF POS=(8,10),LENGTH=41,ATTRB=ASKIP,COLOR=NEUTRAL,        X
               INITIAL='3  Reserves, payments and approvals  CFIN'
         DFHMDF POS=(9,10),LENGTH=41,ATTRB=ASKIP,COLOR=NEUTRAL,        X
               INITIAL='4  My activities                     CACT'
         DFHMDF POS=(12,10),LENGTH=20,ATTRB=ASKIP,COLOR=BLUE,          X
               INITIAL='Option . . . . . . :'
MOPT     DFHMDF POS=(12,32),LENGTH=1,ATTRB=(UNPROT,NUM,FSET,IC),       X
               COLOR=GREEN,HILIGHT=UNDERLINE
         DFHMDF POS=(12,34),LENGTH=1,ATTRB=ASKIP
         DFHMDF POS=(13,10),LENGTH=20,ATTRB=ASKIP,COLOR=BLUE,          X
               INITIAL='Claim number . . . :'
MCLMNO   DFHMDF POS=(13,32),LENGTH=12,ATTRB=(UNPROT,FSET),COLOR=GREEN, X
               HILIGHT=UNDERLINE
         DFHMDF POS=(13,45),LENGTH=1,ATTRB=ASKIP
         DFHMDF POS=(13,47),LENGTH=17,ATTRB=ASKIP,COLOR=BLUE,          X
               INITIAL='(options 2 and 3)'
         DFHMDF POS=(14,10),LENGTH=20,ATTRB=ASKIP,COLOR=BLUE,          X
               INITIAL='Exposure seq . . . :'
MEXPSQ   DFHMDF POS=(14,32),LENGTH=3,ATTRB=(UNPROT,NUM,FSET),          X
               COLOR=GREEN,HILIGHT=UNDERLINE
         DFHMDF POS=(14,36),LENGTH=1,ATTRB=ASKIP
         DFHMDF POS=(14,47),LENGTH=20,ATTRB=ASKIP,COLOR=BLUE,          X
               INITIAL='(option 3, optional)'
MMSG     DFHMDF POS=(23,1),LENGTH=79,ATTRB=ASKIP,COLOR=WHITE
         DFHMDF POS=(24,1),LENGTH=37,ATTRB=ASKIP,COLOR=BLUE,           X
               INITIAL='ENTER=Select  PF3=Exit  CLEAR=Refresh'
*----------------------------------------------------------------------
* CLMFNM
*----------------------------------------------------------------------
CLMFNM   DFHMDI SIZE=(24,80),LINE=1,COLUMN=1
