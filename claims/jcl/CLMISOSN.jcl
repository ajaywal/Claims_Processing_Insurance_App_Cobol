//CLMISOSN JOB (CLMB,0085),'ISO CLAIMSEARCH RECV',CLASS=B,
//             MSGCLASS=X,NOTIFY=&SYSUID,REGION=0M
//*********************************************************************
//* CLAIMSCOREAJ2026 - ISO CLAIMSEARCH RESPONSE POSTING (CLMISOSN)   *
//* TRIGGERED BY ARRIVAL OF THE BUREAU RESPONSE FILE. THE WHOLE FILE *
//* IS BALANCED (HEADER + TRAILER COUNT) BEFORE ANY ROW IS POSTED.   *
//* REQUESTS ARE SENT NIGHTLY BY STEP080 OF CLMEOD (PARM SEND).      *
//* PARM  : RECV[,NNNN] - NNNN COMMIT FREQUENCY (DEFAULT 200)        *
//* CHKPT : CLMISOC1 ONE-RECORD CHECKPOINT (LRECL 100), DISP=OLD.    *
//*         A RERUN FOR THE SAME DATE SKIPS RESPONSES ALREADY POSTED.*
//* RC    : 0 OK, 4 WARNINGS, 8 REJECTED RESPONSES (SEE RPTOUT),     *
//*         12 DB2 ERROR, 16 FILE OUT OF BALANCE - NOTHING POSTED.   *
//*********************************************************************
//STEP010  EXEC PGM=IKJEFT01,DYNAMNBR=20
//STEPLIB  DD DSN=CLM.PROD.LOADLIB,DISP=SHR
//         DD DSN=DSNC10.SDSNLOAD,DISP=SHR
//SYSTSPRT DD SYSOUT=*
//SYSPRINT DD SYSOUT=*
//SYSOUT   DD SYSOUT=*
//SYSUDUMP DD SYSOUT=*
//ISOIN    DD DSN=CLM.PROD.ISO.RESPONSE(0),DISP=SHR
//ISOOUT   DD DUMMY,DCB=(RECFM=FB,LRECL=250,BLKSIZE=0)
//CHKPT    DD DSN=CLM.PROD.CLMISOSN.RECV.CHKPT,DISP=OLD,
//            DCB=(RECFM=FB,LRECL=100,BLKSIZE=0)
//RPTOUT   DD SYSOUT=*,DCB=(RECFM=FBA,LRECL=133)
//SYSTSIN  DD *
  DSN SYSTEM(DB2P)
  RUN PROGRAM(CLMISOSN) PLAN(CLMBATCH) -
      LIB('CLM.PROD.LOADLIB') -
      PARMS('RECV,0200')
  END
/*
