//CLMSEALR JOB (CLMB,0070),'CLAIMS AUDIT SEAL',CLASS=B,
//             MSGCLASS=X,NOTIFY=&SYSUID,REGION=0M
//*********************************************************************
//* CLAIMSCOREAJ2026 - AUDIT CHAIN SEAL (CLMSEALR)                   *
//* LAST STEP OF THE NIGHTLY SCHEDULE. RC 12 = CHAIN BROKEN: RAISE A *
//* SECURITY INCIDENT, DO NOT RERUN UNTIL INVESTIGATED.              *
//* SEALREG IS APPENDED EVERY RUN AND REPLICATED OFF-PLATFORM.       *
//* SYSIN : COL 1 MODE N/R, 3-7 SEAL RANGE SIZE, 9-18 BUS DATE       *
//*         OVERRIDE, 20-22 MAX VERIFY SLICES                        *
//*********************************************************************
//STEP010  EXEC PGM=IKJEFT01,DYNAMNBR=20
//STEPLIB  DD DSN=CLM.PROD.LOADLIB,DISP=SHR
//         DD DSN=DSNC10.SDSNLOAD,DISP=SHR
//SYSTSPRT DD SYSOUT=*
//SYSPRINT DD SYSOUT=*
//SYSOUT   DD SYSOUT=*
//SYSUDUMP DD SYSOUT=*
//SEALREG  DD DSN=CLM.PROD.AUDIT.SEAL.REGISTER,
//            DISP=(MOD,CATLG,CATLG),UNIT=SYSDA,
//            SPACE=(TRK,(15,15)),
//            DCB=(RECFM=FB,LRECL=120,BLKSIZE=0)
//CHKPT    DD DSN=CLM.PROD.CLMSEALR.CHKPT,
//            DISP=(MOD,CATLG,CATLG),UNIT=SYSDA,
//            SPACE=(TRK,(5,5)),
//            DCB=(RECFM=FB,LRECL=80,BLKSIZE=0)
//RPTOUT   DD SYSOUT=*,DCB=(RECFM=FBA,LRECL=133)
//SYSIN    DD *
N 05000            020
/*
//SYSTSIN  DD *
  DSN SYSTEM(DB2P)
  RUN PROGRAM(CLMSEALR) PLAN(CLMBATCH) -
      LIB('CLM.PROD.LOADLIB')
  END
/*
