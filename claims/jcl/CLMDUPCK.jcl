//CLMDUPCK JOB (CLMB,0060),'CLAIMS DUP CHECK',CLASS=B,
//             MSGCLASS=X,NOTIFY=&SYSUID,REGION=0M
//*********************************************************************
//* CLAIMSCOREAJ2026 - DUPLICATE CLAIM DETECTION (CLMDUPCK)          *
//* NIGHTLY WITH A 30-DAY LOOKBACK; MONTH END RUN WITH LOOKBACK 000  *
//* SCANS THE WHOLE BOOK.                                            *
//* SYSIN : COL 1 MODE N/R, 3-7 COMMIT FREQ, 9-18 BUS DATE OVERRIDE, *
//*         20-22 LOOKBACK DAYS (000 = WHOLE BOOK)                   *
//*********************************************************************
//STEP010  EXEC PGM=IKJEFT01,DYNAMNBR=20
//STEPLIB  DD DSN=CLM.PROD.LOADLIB,DISP=SHR
//         DD DSN=DSNC10.SDSNLOAD,DISP=SHR
//SYSTSPRT DD SYSOUT=*
//SYSPRINT DD SYSOUT=*
//SYSOUT   DD SYSOUT=*
//SYSUDUMP DD SYSOUT=*
//CHKPT    DD DSN=CLM.PROD.CLMDUPCK.CHKPT,
//            DISP=(MOD,CATLG,CATLG),UNIT=SYSDA,
//            SPACE=(TRK,(5,5)),
//            DCB=(RECFM=FB,LRECL=80,BLKSIZE=0)
//RPTOUT   DD SYSOUT=*,DCB=(RECFM=FBA,LRECL=133)
//SYSIN    DD *
N 00100            030
/*
//SYSTSIN  DD *
  DSN SYSTEM(DB2P)
  RUN PROGRAM(CLMDUPCK) PLAN(CLMBATCH) -
      LIB('CLM.PROD.LOADLIB')
  END
/*
