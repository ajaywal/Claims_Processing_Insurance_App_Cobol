//CLMFNLBT JOB (CLMB,0010),'CLAIMS FNOL INTAKE',CLASS=B,
//             MSGCLASS=X,NOTIFY=&SYSUID,REGION=0M
//*********************************************************************
//* CLAIMSCOREAJ2026 - BULK FNOL INTAKE (CLMFNLBT)                   *
//* STEP010 DELETES THE PRIOR REJECT FILE; STEP020 RUNS THE INTAKE.  *
//* RESTART: SET THE SYSIN CARD TO 'R' AND RESUBMIT FROM STEP020 -   *
//*          CHKPT IS KEPT (DISP=MOD) SO THE TRAIL IS APPENDED.      *
//* SYSIN : COL 1 MODE N/R, 3-7 COMMIT FREQ, 9-18 BUS DATE OVERRIDE, *
//*         20-22 MAX REJECT PERCENT                                 *
//*********************************************************************
//STEP010  EXEC PGM=IEFBR14
//DELREJ   DD DSN=CLM.PROD.FNOL.REJECTS,
//            DISP=(MOD,DELETE,DELETE),UNIT=SYSDA,SPACE=(TRK,0)
//*
//STEP020  EXEC PGM=IKJEFT01,DYNAMNBR=20,COND=(4,LT,STEP010)
//STEPLIB  DD DSN=CLM.PROD.LOADLIB,DISP=SHR
//         DD DSN=DSNC10.SDSNLOAD,DISP=SHR
//SYSTSPRT DD SYSOUT=*
//SYSPRINT DD SYSOUT=*
//SYSOUT   DD SYSOUT=*
//SYSUDUMP DD SYSOUT=*
//FNOLIN   DD DSN=CLM.PROD.FNOL.PORTAL.FEED(0),DISP=SHR
//FNOLREJ  DD DSN=CLM.PROD.FNOL.REJECTS,
//            DISP=(NEW,CATLG,DELETE),UNIT=SYSDA,
//            SPACE=(CYL,(5,5),RLSE),
//            DCB=(RECFM=FB,LRECL=700,BLKSIZE=0)
//CHKPT    DD DSN=CLM.PROD.CLMFNLBT.CHKPT,
//            DISP=(MOD,CATLG,CATLG),UNIT=SYSDA,
//            SPACE=(TRK,(5,5)),
//            DCB=(RECFM=FB,LRECL=80,BLKSIZE=0)
//RPTOUT   DD SYSOUT=*,DCB=(RECFM=FBA,LRECL=133)
//SYSIN    DD *
N 00200            010
/*
//SYSTSIN  DD *
  DSN SYSTEM(DB2P)
  RUN PROGRAM(CLMFNLBT) PLAN(CLMBATCH) -
      LIB('CLM.PROD.LOADLIB')
  END
/*
