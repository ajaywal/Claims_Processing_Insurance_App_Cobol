//CLMCHKIS JOB (CLMB,0020),'CLAIMS CHECK ISSUE',CLASS=B,
//             MSGCLASS=X,NOTIFY=&SYSUID,REGION=0M
//*********************************************************************
//* CLAIMSCOREAJ2026 - CLAIM CHECK ISSUANCE (CLMCHKIS)               *
//* POSPAY IS A NEW GDG GENERATION PICKED UP BY THE BANK TRANSMIT    *
//* JOB. RESTART: SET SYSIN COL 1 TO 'R', POINT POSPAY AT GENERATION *
//* (0) WITH DISP=MOD; A NEW POSITIVE-PAY BATCH IS APPENDED.         *
//* SYSIN : COL 1 MODE N/R, 3-7 COMMIT FREQ, 9-18 BUS DATE OVERRIDE, *
//*         20-25 BANK SORT CODE, 27-34 BANK ACCOUNT                 *
//*********************************************************************
//STEP010  EXEC PGM=IKJEFT01,DYNAMNBR=20
//STEPLIB  DD DSN=CLM.PROD.LOADLIB,DISP=SHR
//         DD DSN=DSNC10.SDSNLOAD,DISP=SHR
//SYSTSPRT DD SYSOUT=*
//SYSPRINT DD SYSOUT=*
//SYSOUT   DD SYSOUT=*
//SYSUDUMP DD SYSOUT=*
//POSPAY   DD DSN=CLM.PROD.POSPAY.ISSUE(+1),
//            DISP=(NEW,CATLG,DELETE),UNIT=SYSDA,
//            SPACE=(CYL,(2,2),RLSE),
//            DCB=(RECFM=FB,LRECL=150,BLKSIZE=0)
//CHKPT    DD DSN=CLM.PROD.CLMCHKIS.CHKPT,
//            DISP=(MOD,CATLG,CATLG),UNIT=SYSDA,
//            SPACE=(TRK,(5,5)),
//            DCB=(RECFM=FB,LRECL=80,BLKSIZE=0)
//RPTOUT   DD SYSOUT=*,DCB=(RECFM=FBA,LRECL=133)
//SYSIN    DD *
N 00200            601234 41237788
/*
//SYSTSIN  DD *
  DSN SYSTEM(DB2P)
  RUN PROGRAM(CLMCHKIS) PLAN(CLMBATCH) -
      LIB('CLM.PROD.LOADLIB')
  END
/*
