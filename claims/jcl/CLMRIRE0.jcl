//CLMRIRE0 JOB (CLMB,0050),'CLAIMS RI CESSION',CLASS=B,
//             MSGCLASS=X,NOTIFY=&SYSUID,REGION=0M
//*********************************************************************
//* CLAIMSCOREAJ2026 - REINSURANCE CESSION (CLMRIRE0)                *
//* RUNS AFTER THE DAY'S FINANCIALS ARE POSTED. BORDX IS A NEW GDG   *
//* GENERATION FOR THE REINSURANCE ACCOUNTING FEED.                  *
//* RESTART: SYSIN COL 1 'R', BORDX TO GENERATION (0) WITH DISP=MOD. *
//* SYSIN : COL 1 MODE N/R, 3-7 COMMIT FREQ, 9-18 BUS DATE OVERRIDE  *
//*********************************************************************
//STEP010  EXEC PGM=IKJEFT01,DYNAMNBR=20
//STEPLIB  DD DSN=CLM.PROD.LOADLIB,DISP=SHR
//         DD DSN=DSNC10.SDSNLOAD,DISP=SHR
//SYSTSPRT DD SYSOUT=*
//SYSPRINT DD SYSOUT=*
//SYSOUT   DD SYSOUT=*
//SYSUDUMP DD SYSOUT=*
//BORDX    DD DSN=CLM.PROD.RI.BORDEREAU(+1),
//            DISP=(NEW,CATLG,DELETE),UNIT=SYSDA,
//            SPACE=(CYL,(2,2),RLSE),
//            DCB=(RECFM=FB,LRECL=200,BLKSIZE=0)
//CHKPT    DD DSN=CLM.PROD.CLMRIRE0.CHKPT,
//            DISP=(MOD,CATLG,CATLG),UNIT=SYSDA,
//            SPACE=(TRK,(5,5)),
//            DCB=(RECFM=FB,LRECL=80,BLKSIZE=0)
//RPTOUT   DD SYSOUT=*,DCB=(RECFM=FBA,LRECL=133)
//SYSIN    DD *
N 00100
/*
//SYSTSIN  DD *
  DSN SYSTEM(DB2P)
  RUN PROGRAM(CLMRIRE0) PLAN(CLMBATCH) -
      LIB('CLM.PROD.LOADLIB')
  END
/*
