//CLMCATAS JOB (CLMB,0040),'CLAIMS CAT TAGGING',CLASS=B,
//             MSGCLASS=X,NOTIFY=&SYSUID,REGION=0M
//*********************************************************************
//* CLAIMSCOREAJ2026 - CATASTROPHE TAGGING (CLMCATAS)                *
//* RUNS NIGHTLY; RERUN ON DEMAND WHEN A CAT EVENT IS DECLARED.      *
//* SYSIN : COL 1 MODE N/R, 3-7 COMMIT FREQ, 9-18 BUS DATE OVERRIDE  *
//*********************************************************************
//STEP010  EXEC PGM=IKJEFT01,DYNAMNBR=20
//STEPLIB  DD DSN=CLM.PROD.LOADLIB,DISP=SHR
//         DD DSN=DSNC10.SDSNLOAD,DISP=SHR
//SYSTSPRT DD SYSOUT=*
//SYSPRINT DD SYSOUT=*
//SYSOUT   DD SYSOUT=*
//SYSUDUMP DD SYSOUT=*
//CHKPT    DD DSN=CLM.PROD.CLMCATAS.CHKPT,
//            DISP=(MOD,CATLG,CATLG),UNIT=SYSDA,
//            SPACE=(TRK,(5,5)),
//            DCB=(RECFM=FB,LRECL=80,BLKSIZE=0)
//RPTOUT   DD SYSOUT=*,DCB=(RECFM=FBA,LRECL=133)
//SYSIN    DD *
N 00200
/*
//SYSTSIN  DD *
  DSN SYSTEM(DB2P)
  RUN PROGRAM(CLMCATAS) PLAN(CLMBATCH) -
      LIB('CLM.PROD.LOADLIB')
  END
/*
