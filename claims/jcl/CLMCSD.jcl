//CLMCSD   JOB (ACCT),'CLM CSD DEFS',CLASS=A,MSGCLASS=H,
//             NOTIFY=&SYSUID
//*********************************************************************
//* CLMCSD   - ClaimsCoreAJ2026 CICS resource definitions (DFHCSDUP)
//*            Group CLMONL : mapset CLMMSET, 3270 screen programs and
//*                           their transactions (style B)
//*            Group CLMSVC : style A services, LINKed by the screens
//*                           and by each other through COMMAREA
//*            Db2          : DB2ENTRY CLMENTRY (plan CLMPLAN) with a
//*                           DB2TRAN per transaction; the DB2CONN is
//*                           owned by the region and not defined here
//*            List CLMLIST is added to the region's GRPLIST.
//* Rerun safe : groups are deleted first (step DELGRP, RC 4 allowed)
//* Change log : 2026-10-27 AJ  Initial version
//*********************************************************************
//         SET CICSHLQ=CICSTS61.CICS
//         SET CSDDSN=CICSTS61.CICSCLM.DFHCSD
//*
//DELGRP   EXEC PGM=DFHCSDUP,REGION=0M,
//             PARM='CSD(READWRITE),PAGESIZE(60),NOCOMPAT'
//STEPLIB  DD DSN=&CICSHLQ..SDFHLOAD,DISP=SHR
//DFHCSD   DD DSN=&CSDDSN,DISP=SHR
//SYSPRINT DD SYSOUT=*
//SYSIN    DD *
  DELETE GROUP(CLMONL)
  DELETE GROUP(CLMSVC)
/*
//*
//DEFINE   EXEC PGM=DFHCSDUP,REGION=0M,COND=(4,LT,DELGRP),
//             PARM='CSD(READWRITE),PAGESIZE(60),NOCOMPAT'
//STEPLIB  DD DSN=&CICSHLQ..SDFHLOAD,DISP=SHR
//DFHCSD   DD DSN=&CSDDSN,DISP=SHR
//SYSPRINT DD SYSOUT=*
//SYSIN    DD *
*--------------------------------------------------------------------
* Mapset
*--------------------------------------------------------------------
  DEFINE MAPSET(CLMMSET) GROUP(CLMONL)
         DESCRIPTION(ClaimsCore 3270 screens)
         RESIDENT(NO) USAGE(NORMAL) USELPACOPY(NO) STATUS(ENABLED)
*--------------------------------------------------------------------
* Screen programs (style B, pseudo-conversational)
*--------------------------------------------------------------------
  DEFINE PROGRAM(CLMMNUP) GROUP(CLMONL)
         DESCRIPTION(Claims main menu)
         LANGUAGE(LE370) DATALOCATION(ANY) EXECKEY(USER)
         CONCURRENCY(QUASIRENT) RELOAD(NO) RESIDENT(NO)
         STATUS(ENABLED) CEDF(YES)
  DEFINE PROGRAM(CLMFNLP) GROUP(CLMONL)
         DESCRIPTION(First notice of loss)
         LANGUAGE(LE370) DATALOCATION(ANY) EXECKEY(USER)
         CONCURRENCY(QUASIRENT) RELOAD(NO) RESIDENT(NO)
         STATUS(ENABLED) CEDF(YES)
  DEFINE PROGRAM(CLMINQP) GROUP(CLMONL)
         DESCRIPTION(Claim inquiry)
         LANGUAGE(LE370) DATALOCATION(ANY) EXECKEY(USER)
         CONCURRENCY(QUASIRENT) RELOAD(NO) RESIDENT(NO)
         STATUS(ENABLED) CEDF(YES)
  DEFINE PROGRAM(CLMFINP) GROUP(CLMONL)
         DESCRIPTION(Reserves payments and approvals)
         LANGUAGE(LE370) DATALOCATION(ANY) EXECKEY(USER)
         CONCURRENCY(QUASIRENT) RELOAD(NO) RESIDENT(NO)
         STATUS(ENABLED) CEDF(YES)
  DEFINE PROGRAM(CLMACTP) GROUP(CLMONL)
         DESCRIPTION(My activities)
         LANGUAGE(LE370) DATALOCATION(ANY) EXECKEY(USER)
         CONCURRENCY(QUASIRENT) RELOAD(NO) RESIDENT(NO)
         STATUS(ENABLED) CEDF(YES)
*--------------------------------------------------------------------
* Transactions
*--------------------------------------------------------------------
  DEFINE TRANSACTION(CMNU) GROUP(CLMONL)
         DESCRIPTION(Claims main menu)
         PROGRAM(CLMMNUP) TWASIZE(0) PROFILE(DFHCICST)
         TASKDATALOC(ANY) TASKDATAKEY(USER) STATUS(ENABLED)
         RESSEC(NO) CMDSEC(NO) SPURGE(YES) TPURGE(YES)
         DTIMOUT(NO) RUNAWAY(SYSTEM) ISOLATE(YES)
  DEFINE TRANSACTION(CFNL) GROUP(CLMONL)
         DESCRIPTION(First notice of loss)
         PROGRAM(CLMFNLP) TWASIZE(0) PROFILE(DFHCICST)
         TASKDATALOC(ANY) TASKDATAKEY(USER) STATUS(ENABLED)
         RESSEC(NO) CMDSEC(NO) SPURGE(YES) TPURGE(YES)
         DTIMOUT(NO) RUNAWAY(SYSTEM) ISOLATE(YES)
  DEFINE TRANSACTION(CINQ) GROUP(CLMONL)
         DESCRIPTION(Claim inquiry)
         PROGRAM(CLMINQP) TWASIZE(0) PROFILE(DFHCICST)
         TASKDATALOC(ANY) TASKDATAKEY(USER) STATUS(ENABLED)
         RESSEC(NO) CMDSEC(NO) SPURGE(YES) TPURGE(YES)
         DTIMOUT(NO) RUNAWAY(SYSTEM) ISOLATE(YES)
  DEFINE TRANSACTION(CFIN) GROUP(CLMONL)
         DESCRIPTION(Reserves payments and approvals)
         PROGRAM(CLMFINP) TWASIZE(0) PROFILE(DFHCICST)
         TASKDATALOC(ANY) TASKDATAKEY(USER) STATUS(ENABLED)
         RESSEC(NO) CMDSEC(NO) SPURGE(YES) TPURGE(YES)
         DTIMOUT(NO) RUNAWAY(SYSTEM) ISOLATE(YES)
  DEFINE TRANSACTION(CACT) GROUP(CLMONL)
         DESCRIPTION(My activities)
         PROGRAM(CLMACTP) TWASIZE(0) PROFILE(DFHCICST)
         TASKDATALOC(ANY) TASKDATAKEY(USER) STATUS(ENABLED)
         RESSEC(NO) CMDSEC(NO) SPURGE(YES) TPURGE(YES)
         DTIMOUT(NO) RUNAWAY(SYSTEM) ISOLATE(YES)
*--------------------------------------------------------------------
* Style A services (LINK targets; also CALLed in batch)
*--------------------------------------------------------------------
  DEFINE PROGRAM(CLMCLAIM) GROUP(CLMSVC)
         DESCRIPTION(Claim service - FNOL inquiry update close)
         LANGUAGE(LE370) DATALOCATION(ANY) EXECKEY(USER)
         CONCURRENCY(QUASIRENT) API(CICSAPI) STATUS(ENABLED)
  DEFINE PROGRAM(CLMPOLVR) GROUP(CLMSVC)
         DESCRIPTION(Policy verification against GenApp)
         LANGUAGE(LE370) DATALOCATION(ANY) EXECKEY(USER)
         CONCURRENCY(QUASIRENT) API(CICSAPI) STATUS(ENABLED)
  DEFINE PROGRAM(CLMNOTE0) GROUP(CLMSVC)
         DESCRIPTION(Claim notes)
         LANGUAGE(LE370) DATALOCATION(ANY) EXECKEY(USER)
         CONCURRENCY(QUASIRENT) API(CICSAPI) STATUS(ENABLED)
  DEFINE PROGRAM(CLMFINTX) GROUP(CLMSVC)
         DESCRIPTION(Claim financial transactions)
         LANGUAGE(LE370) DATALOCATION(ANY) EXECKEY(USER)
         CONCURRENCY(QUASIRENT) API(CICSAPI) STATUS(ENABLED)
  DEFINE PROGRAM(CLMACTV0) GROUP(CLMSVC)
         DESCRIPTION(Activities)
         LANGUAGE(LE370) DATALOCATION(ANY) EXECKEY(USER)
         CONCURRENCY(QUASIRENT) API(CICSAPI) STATUS(ENABLED)
  DEFINE PROGRAM(CLMCODVL) GROUP(CLMSVC)
         DESCRIPTION(Code table validation)
         LANGUAGE(LE370) DATALOCATION(ANY) EXECKEY(USER)
         CONCURRENCY(QUASIRENT) API(CICSAPI) STATUS(ENABLED)
  DEFINE PROGRAM(CLMDATES) GROUP(CLMSVC)
         DESCRIPTION(Date arithmetic)
         LANGUAGE(LE370) DATALOCATION(ANY) EXECKEY(USER)
         CONCURRENCY(QUASIRENT) API(CICSAPI) STATUS(ENABLED)
  DEFINE PROGRAM(CLMMONEY) GROUP(CLMSVC)
         DESCRIPTION(Money arithmetic)
         LANGUAGE(LE370) DATALOCATION(ANY) EXECKEY(USER)
         CONCURRENCY(QUASIRENT) API(CICSAPI) STATUS(ENABLED)
  DEFINE PROGRAM(CLMERRLG) GROUP(CLMSVC)
         DESCRIPTION(Error log - table and TDQ CSSL)
         LANGUAGE(LE370) DATALOCATION(ANY) EXECKEY(USER)
         CONCURRENCY(QUASIRENT) API(CICSAPI) STATUS(ENABLED)
  DEFINE PROGRAM(CLMSEQGN) GROUP(CLMSVC)
         DESCRIPTION(Sequence numbering)
         LANGUAGE(LE370) DATALOCATION(ANY) EXECKEY(USER)
         CONCURRENCY(QUASIRENT) API(CICSAPI) STATUS(ENABLED)
  DEFINE PROGRAM(CLMEXPOS) GROUP(CLMSVC)
         DESCRIPTION(Exposures)
         LANGUAGE(LE370) DATALOCATION(ANY) EXECKEY(USER)
         CONCURRENCY(QUASIRENT) API(CICSAPI) STATUS(ENABLED)
  DEFINE PROGRAM(CLMINCDT) GROUP(CLMSVC)
         DESCRIPTION(Incidents)
         LANGUAGE(LE370) DATALOCATION(ANY) EXECKEY(USER)
         CONCURRENCY(QUASIRENT) API(CICSAPI) STATUS(ENABLED)
  DEFINE PROGRAM(CLMCONTC) GROUP(CLMSVC)
         DESCRIPTION(Contacts)
         LANGUAGE(LE370) DATALOCATION(ANY) EXECKEY(USER)
         CONCURRENCY(QUASIRENT) API(CICSAPI) STATUS(ENABLED)
  DEFINE PROGRAM(CLMASSGN) GROUP(CLMSVC)
         DESCRIPTION(Assignment engine)
         LANGUAGE(LE370) DATALOCATION(ANY) EXECKEY(USER)
         CONCURRENCY(QUASIRENT) API(CICSAPI) STATUS(ENABLED)
  DEFINE PROGRAM(CLMAUTHZ) GROUP(CLMSVC)
         DESCRIPTION(Authority limits)
         LANGUAGE(LE370) DATALOCATION(ANY) EXECKEY(USER)
         CONCURRENCY(QUASIRENT) API(CICSAPI) STATUS(ENABLED)
  DEFINE PROGRAM(CLMSEGMT) GROUP(CLMSVC)
         DESCRIPTION(Segmentation and severity)
         LANGUAGE(LE370) DATALOCATION(ANY) EXECKEY(USER)
         CONCURRENCY(QUASIRENT) API(CICSAPI) STATUS(ENABLED)
  DEFINE PROGRAM(CLMSIUSC) GROUP(CLMSVC)
         DESCRIPTION(SIU scoring)
         LANGUAGE(LE370) DATALOCATION(ANY) EXECKEY(USER)
         CONCURRENCY(QUASIRENT) API(CICSAPI) STATUS(ENABLED)
  DEFINE PROGRAM(CLMEVTQ) GROUP(CLMSVC)
         DESCRIPTION(Integration event queue)
         LANGUAGE(LE370) DATALOCATION(ANY) EXECKEY(USER)
         CONCURRENCY(QUASIRENT) API(CICSAPI) STATUS(ENABLED)
  DEFINE PROGRAM(CLMHIST0) GROUP(CLMSVC)
         DESCRIPTION(Claim history writer)
         LANGUAGE(LE370) DATALOCATION(ANY) EXECKEY(USER)
         CONCURRENCY(QUASIRENT) API(CICSAPI) STATUS(ENABLED)
  DEFINE PROGRAM(CLMLITIG) GROUP(CLMSVC)
         DESCRIPTION(Litigation matters)
         LANGUAGE(LE370) DATALOCATION(ANY) EXECKEY(USER)
         CONCURRENCY(QUASIRENT) API(CICSAPI) STATUS(ENABLED)
  DEFINE PROGRAM(CLMRECOV) GROUP(CLMSVC)
         DESCRIPTION(Recovery subrogation salvage)
         LANGUAGE(LE370) DATALOCATION(ANY) EXECKEY(USER)
         CONCURRENCY(QUASIRENT) API(CICSAPI) STATUS(ENABLED)
  DEFINE PROGRAM(CLMDOCRQ) GROUP(CLMSVC)
         DESCRIPTION(Document requests)
         LANGUAGE(LE370) DATALOCATION(ANY) EXECKEY(USER)
         CONCURRENCY(QUASIRENT) API(CICSAPI) STATUS(ENABLED)
  DEFINE PROGRAM(CLMAUDCH) GROUP(CLMSVC)
         DESCRIPTION(Audit hash chain)
         LANGUAGE(LE370) DATALOCATION(ANY) EXECKEY(USER)
         CONCURRENCY(QUASIRENT) API(CICSAPI) STATUS(ENABLED)
  DEFINE PROGRAM(CLMSRVRQ) GROUP(CLMSVC)
         DESCRIPTION(Vendor service requests)
         LANGUAGE(LE370) DATALOCATION(ANY) EXECKEY(USER)
         CONCURRENCY(QUASIRENT) API(CICSAPI) STATUS(ENABLED)
*--------------------------------------------------------------------
* Db2 attachment: one entry for the online plan, one DB2TRAN per
* transaction so every CLM task uses thread pool CLMENTRY
*--------------------------------------------------------------------
  DEFINE DB2ENTRY(CLMENTRY) GROUP(CLMONL)
         DESCRIPTION(ClaimsCore online Db2 threads)
         PLAN(CLMPLAN) AUTHTYPE(USERID) ACCOUNTREC(TXID)
         THREADLIMIT(20) THREADWAIT(POOL) PROTECTNUM(5)
         PRIORITY(HIGH) DROLLBACK(YES) STATUS(ENABLED)
  DEFINE DB2TRAN(CLMCMNU) GROUP(CLMONL)
         ENTRY(CLMENTRY) TRANSID(CMNU)
  DEFINE DB2TRAN(CLMCFNL) GROUP(CLMONL)
         ENTRY(CLMENTRY) TRANSID(CFNL)
  DEFINE DB2TRAN(CLMCINQ) GROUP(CLMONL)
         ENTRY(CLMENTRY) TRANSID(CINQ)
  DEFINE DB2TRAN(CLMCFIN) GROUP(CLMONL)
         ENTRY(CLMENTRY) TRANSID(CFIN)
  DEFINE DB2TRAN(CLMCACT) GROUP(CLMONL)
         ENTRY(CLMENTRY) TRANSID(CACT)
*--------------------------------------------------------------------
* Startup list
*--------------------------------------------------------------------
  ADD GROUP(CLMSVC) LIST(CLMLIST)
  ADD GROUP(CLMONL) LIST(CLMLIST) AFTER(CLMSVC)
  LIST LIST(CLMLIST) OBJECTS
/*
//
